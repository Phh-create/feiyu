<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script src="https://cdn.jsdelivr.net/npm/pinyin-pro@3.18.1/dist/index.js"></script>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --bg: linear-gradient(135deg, #4158D0 0%, #C850C0 100%);
    --card: #fff;
    --text: #222;
    --sub: #666;
    --input-bg: #fff;
    --input-bor: #eaeaea;
    --result-bg: #f4f7ff;
    --rule-bg: #f9fafb;
    --pri: #667eea;
    --gray: #909399;
    --danger: #f56c6c;
  }
  [dark] {
    --bg: #1a1a2e;
    --card: #222438;
    --text: #eee;
    --sub: #aaa;
    --input-bg: #2a2c44;
    --input-bor: #3b3d5a;
    --result-bg: #2a2c44;
    --rule-bg: #2a2c44;
    --danger: #e64949;
  }
  body {
    font-family: "Microsoft YaHei", sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 20px;
    animation: bgMove 18s ease infinite alternate;
    background-size: 200% 200%;
  }
  @keyframes bgMove {
    0 { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }
  .card {
    background: var(--card);
    border-radius: 24px;
    max-width: 680px;
    width: 100%;
    padding: 36px 32px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    animation: cardFade 0.8s ease forwards;
    opacity: 0;
    transform: translateY(30px);
  }
  @keyframes cardFade { to { opacity: 1; transform: translateY(0); } }
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 10px;
  }
  .title {
    font-size: 28px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }
  .dark-btn {
    background: var(--pri);
    color: #fff;
    border: none;
    padding: 8px 12px;
    border-radius: 12px;
    cursor: pointer;
    margin-bottom: 6px;
  }
  .subtitle { text-align: center; color: var(--sub); margin: 6px 0 26px; font-size: 15px; }
  textarea {
    width: 100%; height: 130px; border-radius: 16px; padding: 18px; font-size: 16px;
    background: var(--input-bg); border: 1px solid var(--input-bor); color: var(--text);
    resize: none; outline: none; transition: 0.2s;
  }
  .btn-row { display: flex; gap: 10px; margin: 14px 0; flex-wrap:wrap; }
  button {
    flex:1; min-width:120px; padding: 18px; border-radius: 16px; background: var(--pri); color: white;
    font-size: 17px; font-weight: 500; border: none; cursor: pointer; transition: 0.25s;
  }
  button.gray { background: var(--gray); }
  button:hover { opacity: 0.9; transform: translateY(-2px); }
  button:active { transform: translateY(0); }
  .result-box {
    background: var(--result-bg); border-radius: 16px; padding: 22px; min-height: 80px;
    font-size: 19px; line-height: 1.6; word-break: break-all; color: var(--text);
    position: relative;
    white-space: pre-wrap;
  }
  .result-box:empty::before { content: "翻译结果将显示在这里🙃:)"; color: #99a3b8; }
  .copy-btn {
    position: absolute; top: 12px; right: 12px; padding: 6px 10px; font-size: 12px;
    border-radius: 8px; background: var(--pri); color: white; border: none; cursor: pointer;
    opacity: 0; transition: 0.2s;
  }
  .result-box:hover .copy-btn { opacity: 1; }
  .copy-tip { margin-top: 10px; font-size:13px; color:#67C23A; text-align:center; opacity:0; transition:0.3s; }
  .copy-tip.show { opacity:1; }
  .rule-box {
    margin-top:28px; padding:22px; background:var(--rule-bg); border-radius:16px;
    font-size:14px; color:var(--sub); line-height:1.6;
  }
  .rule-box h3 { margin-bottom:10px; font-size:16px; color:var(--text); }
  .footer {
    margin-top:30px; padding-top:20px; border-top:1px solid #4442;
    text-align:center; font-size:13px; color:var(--sub); line-height:1.6;
  }
  .info-bar { display:flex; justify-content:space-between; color:var(--sub); font-size:13px; margin-top:8px; }
  .history-box {
    margin-top:12px; padding:12px; background:var(--rule-bg); border-radius:12px;
    font-size:14px; max-height:120px; overflow-y:auto; position:relative;
  }
  .history-header {
    display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;
  }
  .history-header h4 { font-size:14px; color:var(--text); margin:0; }
  .clear-all-history {
    padding:2px 6px; font-size:12px; border-radius:4px; background:var(--danger); color:white; border:none; cursor:pointer; flex:none; min-width:auto; height:20px; line-height:1;
  }
  .history-item {
    padding:4px 0; cursor:pointer; color:var(--sub); display:flex; justify-content:space-between; align-items:center;
  }
  .history-item:hover { color:var(--pri); }
  .delete-history-item {
    color:var(--danger); cursor:pointer; font-size:12px; margin-left:8px; opacity:0; transition:0.2s;
  }
  .history-item:hover .delete-history-item { opacity:1; }
</style>
</head>
<body>
<div class="card">
  <div class="head">
    <div class="title">FyCipher translator（沸语翻译工具）</div>
<div class="title" style="font-size:22px;margin-top:0;">v4.4 修正尾音素前置声调（8月6日更新）</div>
    <button class="dark-btn" id="darkBtn">🌙 黑夜模式</button>
    <div class="subtitle">FyCipher（沸语）——最简单的语言
      <div class="subtitle">有问题可联系作者邮箱🤩</div>
    </div>
  </div>
  <textarea id="input" placeholder="在此输入中文或沸语😋"></textarea>
  <div class="info-bar">
    <div id="wordCount">字数：0</div>
  </div>
  <div class="btn-row">
    <button id="cnToFyBtn">🔥 汉语→沸语</button>
    <button id="fyToCnBtn">🔄 沸语→拼音</button>
    <button id="copyBtn">📋 复制结果</button>
    <button id="clearBtn" class="gray">🗑️ 清空😥</button>
  </div>
  <div class="result-box" id="output">
    <button class="copy-btn" id="copyBtn">📋 复制</button>
  </div>
  <div class="copy-tip" id="copyTip">✅ 已复制到剪贴板:)</div>
  <div class="history-box">
    <div class="history-header">
      <h4>📜 最近翻译🤓👇</h4>
      <button class="clear-all-history" id="clearAllHistoryBtn">🗑️ 清空所有😭</button>
    </div>
    <div id="historyList"></div>
  </div>
  <div class="rule-box">
    <h3>📘 沸语完整规则</h3>
声母映射：b→zhy、c→ku、ch→kught、d→da、f→nu、g→je、h→ght、j→shb、k→θao、l→ev、m→am、n→nən、p→pie、q→tʃie、r→rb、s→jik、sh→jikght、t→tum、v→vɔ、w→wuda、x→xioz、y→yə、z→zu、zh→zught<br>
基础韵母：a→a、e→mi、i→vi、o→ʌ、u→ʒm；g→je；复韵母直接拆分元音拼接（ai=a+vi=avi）<br>
音节结尾为g/n/a/o/e/i/u/ü时，声调放置在**音节最后一个音素的沸译文前方**；所有字母n统一译为nən；四声符号使用丶
  </div>
  <div class="footer">
    创作者：Pan Honghao<br>
    邮箱：4397637@qq.com / arenabreakout667@163.com
  </div>
</div>

<script>
// 声母正向映射
const sheng = {
  "b":"zhy",
  "c":"ku",
  "ch":"kught",
  "d":"da",
  "f":"nu",
  "g":"je",
  "h":"ght",
  "j":"shb",
  "k":"θao",
  "l":"ev",
  "m":"am",
  "n":"nən",
  "p":"pie",
  "q":"tʃie",
  "r":"rb",
  "s":"jik",
  "sh":"jikght",
  "t":"tum",
  "v":"vɔ",
  "w":"wuda",
  "x":"xioz",
  "y":"yə",
  "z":"zu",
  "zh":"zught"
};
const yun = {"a":"a","e":"mi","i":"vi","o":"ʌ","u":"ʒm"};
// 声调符号 1ˉ 2ˊ 3ˇ 4丶
const tone = {"1":"ˉ","2":"ˊ","3":"ˇ","4":"丶"};

// 反向声母映射
const shengReverse = {
  "zhy":"b",
  "ku":"c",
  "kught":"ch",
  "da":"d",
  "nu":"f",
  "je":"g",
  "ght":"h",
  "shb":"j",
  "θao":"k",
  "ev":"l",
  "am":"m",
  "nən":"n",
  "pie":"p",
  "tʃie":"q",
  "rb":"r",
  "jik":"s",
  "jikght":"sh",
  "tum":"t",
  "vɔ":"v",
  "wuda":"w",
  "xioz":"x",
  "yə":"y",
  "zu":"z",
  "zught":"zh"
};
// 反向韵母加入je对应g
const yunReverse = {"a":"a","mi":"e","vi":"i","ʌ":"o","ʒm":"u","je":"g"};

//带调字符剥离对照表
const toneCharMap = {
    'ā':'a','á':'a','ǎ':'a','à':'a',
    'ē':'e','é':'e','ě':'e','è':'e',
    'ī':'i','í':'i','ǐ':'i','ì':'i',
    'ō':'o','ó':'o','ǒ':'o','ò':'o',
    'ū':'u','ú':'u','ǔ':'u','ù':'u',
    'ǖ':'ü','ǘ':'ü','ǚ':'ü','ǜ':'ü'
};
//允许加声调的尾字符集合
const allowToneEnd = new Set(['g','n','a','o','e','i','u','ü']);

// 中文→沸语【核心修正：声调加在音节最后一个音素前面】
function cnToFy() {
  const text = document.getElementById("input").value.trim();
  if (!text) {
    document.getElementById("output").innerText = "";
    updateWordCount(0);
    saveToLocal();
    return;
  }
  const pyAll = pinyinPro.pinyin(text, { type: "all", multiple: false });
  const resultList = [];

  pyAll.forEach(item => {
    if (!item.isZh) return;
    const initial = item.initial;
    const rawFinal = item.finalHead + item.finalBody + item.finalTail;
    const tNum = String(item.num);
    const toneSym = tone[tNum] ?? "";
    const fyS = sheng[initial] ?? initial;

    // 拿到无调纯韵母，判断末尾字符是否允许加声调
    let pureNoTone = rawFinal.replace(/[āáǎàēéěèīíǐìōóǒòūúǔùǖǘǚǜ]/g, c => toneCharMap[c]);
    let lastBaseChar = pureNoTone.slice(-1) || "";
    const canShowTone = allowToneEnd.has(lastBaseChar);

    // 逐字符生成译文片段数组
    let finalPieces = [];
    for(let k=0;k<rawFinal.length;k++){
      const ch = rawFinal[k];
      const baseCh = toneCharMap[ch] ?? ch;
      let fyChar = "";
      if(yun[baseCh]) fyChar = yun[baseCh];
      else if(baseCh === 'n') fyChar = 'nən';
      else if(baseCh === 'g') fyChar = 'je';
      else fyChar = baseCh;
      finalPieces.push(fyChar);
    }

    // 满足条件：声调插入最后一个片段前面
    if(canShowTone && finalPieces.length > 0){
      const lastFy = finalPieces.pop();
      finalPieces.push(toneSym + lastFy);
    }

    const fullSyllable = fyS + finalPieces.join("");
    resultList.push(fullSyllable);
  })

  const result = resultList.join("  ");
  document.getElementById("output").innerText = result;
  updateWordCount(text.length);
  addToHistory(text, result, "cnToFy");
  saveToLocal();
}

// 沸语→拼音（无改动，保留je识别g、全局替换nən、兼容丶四声）
function fyToCn() {
  const text = document.getElementById("input").value.trim();
  if (!text) {
    document.getElementById("output").innerText = "";
    updateWordCount(0);
    saveToLocal();
    return;
  }
  const fyTone = {"ˉ":"1","ˊ":"2","ˇ":"3","ˋ":"4","丶":"4"};
  const fySyllables = text.split(/\s+/).filter(s=>s);
  const pinyinResult = [];

  for(let syll of fySyllables){
    let toneNum = "";
    let body = syll;
    for(let tSym in fyTone){
      if(body.includes(tSym)){
        toneNum = fyTone[tSym];
        body = body.replaceAll(tSym,"");
        break;
      }
    }

    let shengPart = "";
    let rest = body;
    const shengKeys = Object.keys(shengReverse).sort((a,b)=>b.length-a.length);
    for(let sk of shengKeys){
      if(body.startsWith(sk)){
        shengPart = shengReverse[sk];
        rest = body.slice(sk.length);
        break;
      }
    }

    let yunPart = "";
    const yunKeys = Object.keys(yunReverse).sort((a,b)=>b.length-a.length);
    let pos = 0;
    while(pos < rest.length){
      let matched = false;
      for(let yk of yunKeys){
        if(rest.substr(pos, yk.length) === yk){
          yunPart += yunReverse[yk];
          pos += yk.length;
          matched = true;
          break;
        }
      }
      if(!matched){
        yunPart += rest[pos];
        pos++;
      }
    }

    yunPart = yunPart.replaceAll("nən","n");
    let py = shengPart + yunPart + toneNum;
    pinyinResult.push(py);
  }

  const outText = pinyinResult.join(" ");
  document.getElementById("output").innerText = outText;
  updateWordCount(outText.length);
  addToHistory(text, outText, "fyToCn");
}

// 本地历史、字数、存储全套工具
let history = [];
try{ history = JSON.parse(localStorage.getItem("fyHistory")) || []; }catch(e){}
function updateWordCount(len) { document.getElementById("wordCount").innerText = `字数：${len}`; }
function addToHistory(text, res, type) {
  history = history.filter(i => i.text !== text);
  history.unshift({ text, res, type });
  if (history.length > 10) history = history.slice(0, 10);
  try{ localStorage.setItem("fyHistory", JSON.stringify(history)); }catch(e){}
  renderHistory();
}
function renderHistory() {
  const h = document.getElementById("historyList");
  if (history.length === 0) {
    h.innerHTML = '<div style="color:#999;font-size:12px;">暂无历史记录</div>';
    return;
  }
  h.innerHTML = history.map((i, idx) => `
    <div class='history-item' onclick='useHistory(${idx})'>
      <span>${i.text}</span>
      <span class='delete-history-item' onclick='deleteHistoryItem(${idx}); event.stopPropagation();'>🗑️</span>
    </div>
  `).join("");
}
function deleteHistoryItem(idx) {
  if (confirm("确定删除本条记录😫？")) {
    history.splice(idx,1);
    try{ localStorage.setItem("fyHistory", JSON.stringify(history)); }catch(e){}
    renderHistory();
  }
}
function clearAllHistory() {
  if (confirm("确定清空全部历史？不可恢复😱！")) {
    history = [];
    try{ localStorage.removeItem("fyHistory"); }catch(e){}
    renderHistory();
  }
}
function useHistory(idx) {
  document.getElementById("input").value = history[idx].text;
  if (history[idx].type === "cnToFy") cnToFy();
  else fyToCn();
}
function saveToLocal() { try{ localStorage.setItem("fyInput", document.getElementById("input").value); }catch(e){} }
function loadFromLocal() {
  let val=null;
  try{ val = localStorage.getItem("fyInput"); }catch(e){}
  if (val) document.getElementById("input").value=val;
  renderHistory();
}

// 页面加载完成绑定按钮，解决点击失效
window.onload = function(){
  loadFromLocal();
  document.getElementById("cnToFyBtn").onclick = cnToFy;
  document.getElementById("fyToCnBtn").onclick = fyToCn;
  document.getElementById("copyBtn").onclick = () => {
    const t = document.getElementById("output").innerText;
    if(!t) return;
    navigator.clipboard.writeText(t).then(()=>{
      const tip = document.getElementById("copyTip");
      tip.classList.add("show");
      setTimeout(()=>tip.classList.remove("show"),2000);
    });
  };
  document.getElementById("clearBtn").onclick = () => {
    document.getElementById("input").value = "";
    document.getElementById("output").innerText = "";
    updateWordCount(0);
    saveToLocal();
  };
  document.getElementById("darkBtn").onclick = () => {
    document.body.toggleAttribute("dark");
    darkBtn.textContent = document.body.hasAttribute("dark") ? "☀️ 白天模式" : "🌙 黑夜模式";
  };
  document.getElementById("clearAllHistoryBtn").onclick = clearAllHistory;
}
</script>
</body>
  </html>
